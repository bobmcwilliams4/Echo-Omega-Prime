# ECHO OMEGA PRIME — Monorepo .gitignore

# === Dependencies ===
node_modules/
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
*.egg-info/
*.whl

# === Environment & Secrets ===
.env
.env.*
!.env.example
SECURE_VAULT/
*.pem
*.key
*.p12
*_KEY*.txt
*_token.txt
service_account*.json
api_keychain*.env

# === Build Artifacts ===
.next/
.vercel/
.wrangler/
dist/
build/
.cache/
.turbo/
*.tsbuildinfo

# === IDE & OS ===
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# === Databases (D1 source of truth, not git) ===
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# === Logs & Temp ===
*.log
logs/
*.tmp
*.temp
*.bak
*.bak_*
_temp_*
_tmp_*

# === Large Files (media, models) ===
*.mp4
*.mov
*.mp3
*.wav
*.gguf
*.safetensors
*.bin
*.zip
*.tar.gz
*.rar
*.7z

# === Data (too large for git) ===
data/
*.csv
*.parquet
*.ndjson

# === FORGE-X build cache ===
_forge_x_cache/
_forge_x_logs/
_forge_x_quarantine/

# === Crystal Memory & Sessions ===
CRYSTALS*/
sessions/
snapshots/
.r2_synced

# === Specific Exclusions ===
CLAUDE_CODE_INSTANCES/
tasks/*.output
