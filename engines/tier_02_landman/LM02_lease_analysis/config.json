      "secondary_term_trigger": "production_or_operations",
      "description": "Defines the duration of the lease grant"
    },
    "drilling_clause": {
      "types": ["commence_operations", "spud_well", "complete_well"],
      "grace_period_days": [30, 60, 90, 120, 180],
      "description": "Obligations regarding commencement of drilling"
    },
    "delay_rental": {
      "payment_schedule": "annual",
      "typical_rate_per_acre": [5.0, 50.0],
      "or_clause_vs_unless_clause": "unless",
      "description": "Payments to maintain lease during primary term without drilling"
    },
    "royalty": {
      "default_fraction": "1/8",
      "common_fractions": ["1/8", "3/16", "1/5", "1/4"],
      "decimal_equivalents": {
        "1/8": 0.125,
        "3/16": 0.1875,
        "1/5": 0.20,
