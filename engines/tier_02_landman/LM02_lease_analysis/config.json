    },
    "preferential_right": {
      "trigger": "proposed_assignment",
      "response_period_days": [15, 30, 60],
      "description": "Right of first refusal on lease assignment"
    },
    "assignment_sublease": {
      "consent_required": false,
      "partial_assignment_allowed": true,
      "overriding_royalty_reservation": true,
      "description": "Transfer of lease rights to third party"
    },
    "mother_hubbard": {
      "coverage": "contiguous_or_adjacent_strips",
      "typical_limit_acres": 10,
      "description": "Covers small tracts or strips adjacent to described lands"
    },
    "surrender_clause": {
      "notice_requirement_days": 30,
      "partial_surrender_allowed": true,
      "rental_obligation_on_surrender": "pro_rata_refund",
      "description": "Lessee right to release all or part of leased premises"
