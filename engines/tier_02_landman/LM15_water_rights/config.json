  "seismicity_monitoring": {
    "texnet_integration": true,
    "magnitude_threshold_review": 2.0,
    "magnitude_threshold_curtailment": 3.5,
    "magnitude_threshold_shutin": 4.0,
    "radius_of_review_miles": 10,
    "traffic_light_protocol": {
      "green": {"magnitude_below": 2.0, "action": "continue_operations"},
      "yellow": {"magnitude_range": [2.0, 3.5], "action": "reduce_volume_50_pct"},
      "orange": {"magnitude_range": [3.5, 4.0], "action": "suspend_and_review"},
      "red": {"magnitude_above": 4.0, "action": "immediate_shutin_and_report"}
    }
  },

