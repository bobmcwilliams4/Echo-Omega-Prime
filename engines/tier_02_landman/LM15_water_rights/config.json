  "tier": "LANDMAN",
  "authority": 5.0,
  "category": "LANDMAN",
  "subcategory": "WATER_RIGHTS",
  "description": "Comprehensive Texas water rights analysis engine covering groundwater law, surface water appropriation, produced water management, saltwater disposal, aquifer analysis, and oil-and-gas water compliance",
  "author": "ECHO OMEGA PRIME Build System",
  "commander": "Bobby Don McWilliams II",
  "created": "2026-02-10",
  "log_level": "INFO",
  "max_concurrent_analyses": 16,
  "analysis_timeout_seconds": 120,
  "cache_ttl_seconds": 3600,

  "tie_20_components": {
    "C01_doctrine_cache": true,
    "C02_semantic_dictionary": true,
    "C03_search_index": true,
    "C04_telemetry": true,
    "C05_pydantic_models": true,
    "C06_determinism_hash": true,
    "C07_health_endpoint": true,
    "C08_config_loader": true,
    "C09_risk_scoring": true,
    "C10_compliance_checker": true,
    "C11_audit_trail": true,
    "C12_drift_watcher": true,
    "C13_coverage_map": true,
    "C14_integrity_verifier": true,
    "C15_response_modes": true,
    "C16_error_handler": true,
    "C17_async_operations": true,
    "C18_logging_structured": true,
    "C19_export_formats": true,
    "C20_version_tracker": true
  },

  "response_modes": {
    "fast": {
      "description": "Quick classification and risk flag",
      "max_doctrines": 3,
      "include_analysis": false,
      "include_citations": false,
      "target_latency_ms": 200
    },
    "analysis": {
      "description": "Full water rights analysis with doctrine application",
      "max_doctrines": 20,
      "include_analysis": true,
      "include_citations": true,
      "target_latency_ms": 2000
    },
    "memo": {
      "description": "Attorney-grade memorandum with full citation chain",
      "max_doctrines": 50,
      "include_analysis": true,
      "include_citations": true,
      "include_case_law": true,
      "target_latency_ms": 5000
    },
    "water_permit": {
      "description": "Water permit compliance analysis and checklist",
      "max_doctrines": 30,
      "include_analysis": true,
      "include_citations": true,
      "include_permit_checklist": true,
      "include_gcd_rules": true,
      "target_latency_ms": 3000
    },
    "disposal_compliance": {
      "description": "SWD/injection well compliance deep-dive",
      "max_doctrines": 30,
      "include_analysis": true,
      "include_citations": true,
      "include_seismicity": true,
      "include_mit_status": true,
      "include_rrc_rules": true,
      "target_latency_ms": 3000
    }
  },

  "layers": {
    "L1_classification": {
      "description": "Water type classification and right identification",
      "operations": ["classify_water_type", "identify_right_type", "determine_jurisdiction"],
      "weight": 0.15
    },
    "L2_regulatory": {
      "description": "Applicable regulatory framework identification",
      "operations": ["identify_gcd", "check_tceq_requirements", "check_rrc_requirements", "check_federal_requirements"],
      "weight": 0.30
    },
    "L3_compliance": {
      "description": "Compliance scoring and risk assessment",
      "operations": ["score_permit_compliance", "check_mit_status", "evaluate_seismicity", "assess_environmental_risk"],
      "weight": 0.35
    },
    "L4_advisory": {
      "description": "Recommendations and action items",
      "operations": ["generate_recommendations", "identify_permit_gaps", "flag_upcoming_deadlines", "suggest_alternatives"],
      "weight": 0.20
    }
  },

