      "grant_types": ["homestead_patent", "cash_entry_patent", "railroad_grant", "military_bounty"],
      "validity_basis": "US Constitution Art. IV"
    }
  },

  "recording_act_rules": {
    "texas_race_notice": {
      "statute": "Texas Property Code Section 13.001",
      "type": "race_notice",
      "priority_rule": "first_recorded_bfp_wins",
      "bfp_requirements": ["valuable_consideration", "good_faith", "no_actual_notice", "no_constructive_notice"],
      "constructive_notice_sources": ["deed_records", "lis_pendens", "tax_records", "judgment_liens", "ucc_filings"],
      "actual_notice_types": ["direct_knowledge", "inquiry_notice", "possession_notice"],
      "recording_required_for_priority": true,
      "unrecorded_deed_valid_between_parties": true,
      "grace_period_days": 0,
      "shelter_rule_applies": true
    },
    "oklahoma_race_notice": {
      "statute": "16 O.S. Section 16",
      "type": "race_notice",
      "priority_rule": "first_recorded_bfp_wins"
    },
    "new_mexico_race_notice": {
      "statute": "NMSA Section 14-9-3",
      "type": "race_notice",
      "priority_rule": "first_recorded_bfp_wins"
    }
  },

