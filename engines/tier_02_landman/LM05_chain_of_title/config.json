  "sovereign_origins": {
    "spanish_crown": {
      "authority": "Kingdom of Spain",
      "period": "pre-1821",
      "grant_types": ["royal_grant", "empresario_grant", "mission_grant"],
      "validity_basis": "Treaty of Guadalupe Hidalgo 1848"
    },
    "republic_of_mexico": {
      "authority": "Republic of Mexico",
      "period": "1821-1836",
      "grant_types": ["colonization_grant", "empresario_grant"],
