{
  "engine_id": "LM18",
  "engine_name": "Title Insurance Engine",
  "version": "1.0.0",
  "port": 8518,
  "domain": "title_insurance",
  "description": "TIE Gold Standard landman intelligence engine for title insurance underwriting, policy analysis, commitment review, endorsements, claims, and rate regulation across oil & gas and real estate transactions.",
  "host": "0.0.0.0",
  "log_level": "DEBUG",
  "log_rotation": "50 MB",
  "log_retention": "30 days",
  "cors_origins": ["*"],
  "response_modes": ["FAST", "DEFENSE", "MEMO"],
  "confidence_levels": ["DEFENSIBLE", "AGGRESSIVE", "DISCLOSURE", "HIGH_RISK"],
  "authority_hierarchy": [
    {"level": 1, "source": "texas_insurance_code", "weight": 1.0},
    {"level": 2, "source": "tdi_rate_rules", "weight": 0.95},
    {"level": 3, "source": "alta_policy_forms", "weight": 0.92},
    {"level": 4, "source": "tlta_standards", "weight": 0.88},
    {"level": 5, "source": "underwriting_manuals", "weight": 0.85},
    {"level": 6, "source": "case_law_precedent", "weight": 0.82},
    {"level": 7, "source": "industry_practice", "weight": 0.75},
    {"level": 8, "source": "secondary_commentary", "weight": 0.60}
  ],
  "issue_categories": [
    "POLICY_COVERAGE",
    "COMMITMENT_REVIEW",
    "ENDORSEMENT_ANALYSIS",
    "UNDERWRITING_RISK",
    "MINERAL_EXCLUSION",
    "CLAIMS_LOSS",
    "RATE_REGULATION",
    "SURVEY_EXCEPTION",
    "LIEN_ANALYSIS",
    "GAP_COVERAGE",
    "CURATIVE_REQUIREMENTS",
    "CLOSING_PROTECTION"
  ],
  "position_zones": ["PLANNING", "REPORTING", "AUDIT"],
  "telemetry": {
    "enabled": true,
    "metrics_port": 8519,
    "flush_interval_seconds": 60,
    "max_buffer_size": 10000
  },
  "vector_search": {
    "enabled": true,
    "embedding_model": "all-MiniLM-L6-v2",
    "similarity_threshold": 0.72,
    "max_results": 10
  },
  "drift_watcher": {
    "enabled": true,
    "check_interval_hours": 24,
    "drift_threshold": 0.15,
    "alert_on_drift": true
  },
  "doctrine_cache": {
    "preload": true,
    "max_age_hours": 168,
    "min_blocks": 40
  },
  "audit_trail": {
    "enabled": true,
    "format": "jsonl",
    "path": "audit_trail.jsonl",
    "retention_days": 365
  },
  "health_check": {
    "endpoint": "/health",
    "include_doctrine_count": true,
    "include_uptime": true,
    "include_version": true
  },
  "texas_specific": {
    "rate_regulator": "Texas Department of Insurance (TDI)",
    "basic_premium_rate": "promulgated",
    "simultaneous_issue_discount": true,
    "title_plant_requirements": true,
    "tlta_forms_mandatory": true
  }
}
