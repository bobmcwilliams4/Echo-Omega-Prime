_block else ""
    controlling_precedent = primary_block.controlling_precedent if primary_block else ""
    position_zone = primary_block.position_zone.name if primary_block else ""
    issue_category = primary_block.issue_category.name if primary_block else ""
    entity_scope = primary_block.entity_scope if primary_block else ""
    confidence = primary_block.confidence if primary_block else 0.0
    confidence_zone = primary_block.confidence_zone.name if primary_block else ""
    burden_holder = primary_block.burden_holder if primary_block else ""
    adversary_position = primary_block.adversary_position if primary_block else ""
    fact_fragility = score_fact_fragility(primary_conclusion) if primary_block else 0.0
    determinism = determinism_hash({
        "scenario": scenario,
        "doctrine_ids": doctrine_ids,
        "primary_conclusion": primary_conclusion
    })
    response = {
        "query_id": query_id,
        "scenario": scenario,
        "mode": mode,
        "doctrine_ids": doctrine_ids,
        "primary_conclusion": primary_conclusion,
        "reasoning_framework": reasoning_framework,
        "key_factors": key_factors,
        "primary_authority": primary_authority,
        "counter_arguments": counter_arguments,
        "resolution_strategy": resolution_strategy,
        "controlling_precedent": controlling_precedent,
        "position_zone": position_zone,
        "issue_category": issue_category,
        "entity_scope": entity_scope,
        "confidence": confidence,
        "confidence_zone": confidence_zone,
        "burden_holder": burden_holder,
        "adversary_position": adversary_position,
        "fact_fragility": fact_fragility,
        "coverage": coverage,
        "multi_doctrine_decomposition": multi_decomp,
        "determinism_hash": determinism,
        "timestamp": datetime.utcnow().isoformat()
    }
    log_audit_trail(query_id, request.dict(), response)
    elapsed = (datetime.utcnow() - start).total_seconds()
    logger.info(f"Query {query_id} processed in {elapsed:.3f}s")
    return response

@app.get("/health")
async def health():
    return {"status": "ok", "drift": detect_drift(), "timestamp": datetime.utcnow().isoformat()}

@app.post("/analyze")
async def analyze(request: QueryRequest):
    scenario = request.scenario
    doctrine_ids = doctrine_cache_lookup(scenario)
    semantic_hits = semantic_search(scenario)
    deep_hits = deep_analysis(scenario)
    multi_decomp = multi_doctrine_decomposition(scenario)
    coverage = coverage_map(scenario)
    return {
        "doctrine_cache_lookup": doctrine_ids,
        "semantic_search": semantic_hits,
        "deep_analysis": deep_hits,
        "multi_doctrine_decomposition": multi_decomp,
        "coverage": coverage,
        "timestamp": datetime.utcnow().isoformat()
    }

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("TX10_state_nexus.engine:app", host="0.0.0.0", port=8510, reload=False)
