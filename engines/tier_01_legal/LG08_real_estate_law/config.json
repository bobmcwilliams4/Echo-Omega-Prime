{
    "engine_id": "LG08",
    "engine_name": "Real Estate Law Engine",
    "engine_version": "2.0.0",
    "engine_authority": 5.0,
    "engine_tier": "LEGAL",
    "engine_mode": "DET",
    "port": 8398,
    "host": "0.0.0.0",

    "description": "Production-grade real estate law analysis engine providing property transaction review, title examination, deed analysis, easement and covenant interpretation, zoning compliance, landlord-tenant law, property tax assessment, eminent domain, HOA/POA governance, real estate financing, foreclosure, 1031 exchanges, RESPA/TILA/Fair Housing compliance, Texas community property, homestead exemption, and oil & gas surface/mineral rights analysis across federal and state statutory frameworks.",

    "architecture": {
        "layers": [
            {
                "name": "Doctrine Cache",
                "order": 1,
                "latency_target_ms": 200,
                "description": "Pre-compiled real estate doctrine for instant retrieval on common property, title, deed, zoning, and financing queries"
            },
            {
                "name": "Semantic Search",
                "order": 2,
                "latency_target_ms": 700,
                "description": "TF-IDF inverted index search over real estate doctrine blocks and statutory references"
            },
            {
                "name": "Real Estate Analysis",
                "order": 3,
                "latency_target_ms": 1500,
                "description": "Structured real estate analysis including title chain review, deed interpretation, and compliance assessment"
            },
            {
                "name": "Deep Analysis",
                "order": 4,
                "latency_target_ms": 3000,
                "description": "Multi-doctrine synthesis for complex transactions, multi-jurisdictional issues, and mineral rights conflicts"
            }
        ],
        "normalization": "semantic.py",
        "telemetry": "telemetry.py",
        "search": "search.py",
        "doctrines": "doctrines.py",
        "engine": "engine.py"
    },

    "response_modes": {
        "fast": {
            "description": "Quick doctrine-driven real estate guidance with key statutory citations",
            "max_latency_ms": 2000,
            "min_citations": 1
        },
        "analysis": {
            "description": "Structured real estate analysis with title examination and statutory framework",
            "max_latency_ms": 5000,
            "min_citations": 3
        },
        "memo": {
            "description": "Full real estate memorandum with comprehensive citation and risk assessment",
            "max_latency_ms": 10000,
            "min_citations": 5
        },
        "title_opinion": {
            "description": "Title opinion mode with chain of title review and encumbrance analysis",
            "max_latency_ms": 12000,
            "min_citations": 8
        },
        "transaction_review": {
            "description": "Full transaction review with due diligence checklist and compliance verification",
            "max_latency_ms": 15000,
            "min_citations": 10
        }
    },

    "real_estate_categories": {
        "property_transactions": {
            "types": ["purchase", "sale", "lease", "option", "right_of_first_refusal", "exchange_1031", "installment_sale"],
            "key_statutes": ["UCC Article 2A", "State Recording Acts", "Statute of Frauds"],
            "common_issues": ["contract_formation", "financing_contingency", "inspection_period", "title_defects", "closing_costs"]
        },
        "title_examination": {
            "types": ["full_title_search", "current_owner_search", "litigation_guarantee", "title_insurance_commitment"],
            "key_issues": ["chain_of_title", "encumbrances", "liens", "judgments", "lis_pendens", "tax_liens", "mechanics_liens"],
            "title_insurance": ["owners_policy", "lenders_policy", "enhanced_policy", "alta_forms"]
        },
        "deed_types": {
            "general_warranty": {"protection": "full", "covenants": ["seisin", "right_to_convey", "against_encumbrances", "quiet_enjoyment", "warranty", "further_assurances"]},
            "special_warranty": {"protection": "limited", "covenants": ["seisin_during_ownership", "no_encumbrances_during_ownership"]},
            "quitclaim": {"protection": "none", "covenants": []},
            "deed_of_trust": {"purpose": "security_instrument", "parties": ["trustor", "trustee", "beneficiary"]},
            "bargain_and_sale": {"protection": "implied_seisin", "covenants": ["implied_ownership"]},
            "grant_deed": {"protection": "statutory", "covenants": ["no_prior_conveyance", "no_encumbrances_by_grantor"]}
        },
        "easements": {
            "types": ["express", "implied", "prescriptive", "by_necessity", "conservation", "utility"],
            "termination": ["merger", "release", "abandonment", "condemnation", "expiration", "estoppel"],
            "key_issues": ["scope", "location", "maintenance", "transferability", "dominant_vs_servient"]
        },
        "zoning_land_use": {
            "classifications": ["residential", "commercial", "industrial", "agricultural", "mixed_use", "planned_unit_development"],
            "processes": ["rezoning", "variance", "conditional_use_permit", "special_exception", "comprehensive_plan_amendment"],
            "takings": ["regulatory_taking", "physical_taking", "inverse_condemnation", "penn_central_test"]
        },
        "landlord_tenant": {
            "lease_types": ["gross_lease", "net_lease", "triple_net_nnn", "percentage_lease", "ground_lease", "month_to_month"],
            "key_issues": ["security_deposit", "eviction", "habitability", "repair_obligations", "subletting", "assignment"],
            "commercial_lease": ["cam_charges", "tenant_improvements", "build_out", "renewal_options", "rent_escalation"]
        },
        "financing": {
            "types": ["conventional", "fha", "va", "usda", "jumbo", "hard_money", "seller_financing", "wraparound"],
            "instruments": ["mortgage", "deed_of_trust", "promissory_note", "security_agreement"],
            "regulations": ["respa", "tila", "ecoa", "hmda", "dodd_frank", "safe_act"]
        },
        "foreclosure": {
            "types": ["judicial", "non_judicial", "strict_foreclosure"],
            "processes": ["notice_of_default", "acceleration", "sale", "deficiency_judgment", "right_of_redemption"],
            "alternatives": ["short_sale", "deed_in_lieu", "loan_modification", "forbearance"]
        },
        "eminent_domain": {
            "requirements": ["public_use", "just_compensation", "due_process", "necessity"],
            "valuation": ["fair_market_value", "highest_and_best_use", "before_and_after_method", "comparable_sales"],
            "key_cases": ["Kelo v. City of New London", "Penn Central v. NYC", "Lucas v. SC Coastal Council"]
        },
        "hoa_poa": {
            "governance": ["cc_and_rs", "bylaws", "rules_and_regulations", "architectural_guidelines"],
            "issues": ["assessment_collection", "enforcement", "board_elections", "amendment_procedures"],
            "statutes": ["state_nonprofit_act", "state_hoa_act", "davis_stirling_ca", "texas_property_code_ch_209"]
        },
        "tax_1031_exchange": {
            "requirements": ["like_kind", "qualified_intermediary", "45_day_identification", "180_day_closing", "held_for_investment"],
            "types": ["delayed_exchange", "reverse_exchange", "improvement_exchange", "simultaneous"],
            "restrictions": ["related_party", "personal_use", "partnership_interests", "boot"]
        },
        "texas_specific": {
            "community_property": ["characterization", "management_control", "partition", "inception_of_title", "tracing"],
            "homestead": ["urban_homestead_10_acres", "rural_homestead_200_acres", "forced_sale_protection", "tax_exemption", "liens_on_homestead"],
            "property_code": ["ch_5_conveyances", "ch_11_executory_contracts", "ch_12_recording", "ch_41_homestead", "ch_51_foreclosure", "ch_92_tenant_rights", "ch_209_poa"],
            "mineral_rights": ["surface_vs_mineral_estate", "accommodation_doctrine", "dominant_mineral_estate", "pooling_unitization", "royalty_vs_working_interest"]
        }
    },

    "authority_weights": {
        "us_supreme_court": 100,
        "state_supreme_court": 90,
        "federal_circuit_court": 85,
        "state_appellate_court": 75,
        "federal_district_court": 70,
        "state_trial_court": 55,
        "federal_statute": 95,
        "state_statute": 90,
        "local_ordinance": 60,
        "cfr_regulation": 80,
        "cfpb_guidance": 70,
        "hud_regulation": 75,
        "alta_form": 65,
        "restatement_property": 50,
        "treatise": 40,
        "title_standard": 55,
        "bar_association_opinion": 45,
        "law_review": 30
    },

    "confidence_bands": {
        "DEFENSIBLE": {
            "min_score": 0.85,
            "label": "Position is well-supported by established real estate law and precedent",
            "requires_caveat": false
        },
        "SUPPORTABLE": {
            "min_score": 0.65,
            "label": "Position has reasonable support but some uncertainty in application",
            "requires_caveat": true
        },
        "DISCLOSURE": {
            "min_score": 0.50,
            "label": "Position requires disclosure of contrary authority or jurisdictional variation",
            "requires_caveat": true
        },
        "HIGH_RISK": {
            "min_score": 0.0,
            "label": "Position faces significant adverse authority or untested legal theory",
            "requires_caveat": true
        }
    },

    "drift_watcher": {
        "enabled": true,
        "check_interval_hours": 24,
        "staleness_threshold_days": 90,
        "confidence_reduction_percent": 10,
        "registry_path": "doctrine_drift_registry.json",
        "signal_types": [
            "new_real_estate_case",
            "state_supreme_court_opinion",
            "scotus_cert_grant",
            "legislative_change",
            "cfpb_regulation",
            "hud_policy_change",
            "local_ordinance_amendment",
            "title_standard_update",
            "tax_code_amendment",
            "zoning_code_revision"
        ]
    },

    "telemetry": {
        "enabled": true,
        "ring_buffer_size": 10000,
        "flush_batch_size": 50,
        "flush_interval_seconds": 5.0,
        "log_dir": "logs",
        "retention_days": 30
    },

    "search": {
        "default_top_k": 5,
        "score_threshold": 0.3,
        "max_token_length": 50,
        "min_token_length": 2
    },

    "audit": {
        "enabled": true,
        "log_format": "jsonl",
        "hash_algorithm": "sha256",
        "retention_days": 365
    },

    "epistemic_guardrails": {
        "banned_phrases": [
            "This title is definitely clear",
            "There are absolutely no encumbrances",
            "The property is guaranteed to close",
            "You will certainly win this foreclosure",
            "No court would find a taking",
            "This deed is bulletproof",
            "The zoning will definitely be approved",
            "There is zero risk in this transaction",
            "The HOA cannot enforce this restriction",
            "This lease is completely enforceable",
            "Your homestead claim is guaranteed",
            "The mineral rights are absolutely separated",
            "This 1031 exchange will certainly qualify",
            "RESPA does not apply here"
        ],
        "required_disclaimers": {
            "not_legal_advice": "This analysis is for informational purposes only and does not constitute legal advice. Consult a licensed real estate attorney for specific legal guidance.",
            "jurisdiction_specific": "Real estate law varies significantly by state and locality. This analysis may not apply in all jurisdictions.",
            "fact_dependent": "Real estate outcomes depend heavily on specific facts, property conditions, title history, and local regulations. This analysis is based on the information provided.",
            "title_caveat": "Title opinions and searches cannot guarantee completeness. Undiscovered liens, encumbrances, or defects may exist."
        }
    },

    "cors": {
        "allow_origins": ["*"],
        "allow_methods": ["GET", "POST", "OPTIONS"],
        "allow_headers": ["*"]
    },

    "logging": {
        "level": "INFO",
        "format": "{time:YYYY-MM-DD HH:mm:ss.SSS} | {level} | {message}",
        "rotation": "50 MB",
        "retention": "30 days"
    },

    "metadata": {
        "author": "ECHO OMEGA PRIME",
        "authority": "11.0 SOVEREIGN",
        "build_date": "2026-02-10",
        "domain": "Real Estate Law",
        "classification": "LEGAL",
        "tier_id": 1,
        "engine_index": 8,
        "total_target_lines": 10500
    }
}
