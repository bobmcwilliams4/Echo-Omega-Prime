        "scale_max": 1000,
        "severity_weights": {
            "criminal": 10,
            "civil_penalty": 8,
            "administrative_action": 6,
            "warning_letter": 4,
            "voluntary_disclosure": 2
        },
        "likelihood_weights": {
            "certain": 10,
            "likely": 8,
            "possible": 6,
            "unlikely": 4,
            "rare": 2
        },
        "detectability_weights": {
            "automatic_reporting": 10,
            "routine_audit": 8,
            "targeted_examination": 6,
            "complaint_driven": 4,
            "unlikely_detection": 2
        }
    },

