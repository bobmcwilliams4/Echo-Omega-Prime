    "description": "Professional-grade case law research and analysis engine providing structured legal doctrine, Bluebook citation parsing, Shepardize verification, precedent chain tracking, court hierarchy analysis, opinion section parsing, headnote extraction, key number mapping, and litigation strategy support.",

    "architecture": {
        "layers": [
            {
                "name": "Doctrine Cache",
                "order": 1,
                "latency_target_ms": 200,
                "description": "Pre-compiled expert legal doctrine for instant retrieval"
            },
            {
                "name": "Semantic Search",
                "order": 2,
                "latency_target_ms": 700,
                "description": "TF-IDF inverted index search over doctrine blocks"
            },
            {
                "name": "Citation Analysis",
                "order": 3,
                "latency_target_ms": 1500,
                "description": "Citation parsing, Shepardize, precedent chain resolution"
            },
            {
                "name": "Deep Analysis",
                "order": 4,
                "latency_target_ms": 3000,
                "description": "Multi-source synthesis for complex legal questions"
            }
        ],
        "normalization": "semantic.py",
        "telemetry": "telemetry.py",
        "search": "search.py",
        "doctrines": "doctrines.py",
        "engine": "engine.py"
    },

    "response_modes": {
        "fast": {
            "description": "Quick doctrine-driven response with key citations",
            "max_latency_ms": 2000,
            "min_citations": 1
        },
        "defense": {
            "description": "Structured analysis with opposing arguments and risk assessment",
            "max_latency_ms": 5000,
            "min_citations": 3
        },
        "memo": {
            "description": "Full legal memorandum format with comprehensive citation",
            "max_latency_ms": 10000,
            "min_citations": 5
        },
        "shepardize": {
            "description": "Citation verification and treatment analysis mode",
            "max_latency_ms": 8000,
            "min_citations": 1
        },
        "precedent_chain": {
            "description": "Full precedent ancestry and descendant analysis",
            "max_latency_ms": 15000,
            "min_citations": 5
        }
    },

