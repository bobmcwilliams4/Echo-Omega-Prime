    "opinion_sections": {
        "syllabus": {
            "description": "Court-prepared summary of holding and reasoning",
            "binding": false,
            "weight_modifier": 0.3
        },
        "majority": {
            "description": "Opinion of the court, joined by a majority of justices",
            "binding": true,
            "weight_modifier": 1.0
        },
        "plurality": {
            "description": "Opinion joined by the largest group but not a majority",
            "binding": "limited",
            "weight_modifier": 0.7
        },
        "concurrence": {
            "description": "Justice agrees with result but on different reasoning",
            "binding": false,
            "weight_modifier": 0.4
        },
        "concurrence_in_judgment": {
            "description": "Justice agrees with result but rejects majority reasoning entirely",
            "binding": false,
            "weight_modifier": 0.3
        },
        "dissent": {
            "description": "Justice disagrees with both result and reasoning",
            "binding": false,
            "weight_modifier": 0.2
        },
        "per_curiam": {
            "description": "Unsigned opinion of the court as a whole",
            "binding": true,
            "weight_modifier": 0.9
        }
    },

    "drift_watcher": {
        "enabled": true,
        "check_interval_hours": 24,
        "staleness_threshold_days": 90,
        "confidence_reduction_percent": 10,
        "registry_path": "doctrine_drift_registry.json",
        "signal_types": [
            "new_case_law",
            "overruled_precedent",
            "circuit_split",
            "legislative_change",
            "rule_amendment",
            "scotus_cert_grant",
            "en_banc_rehearing"
        ]
    },

    "telemetry": {
        "enabled": true,
        "ring_buffer_size": 10000,
        "flush_batch_size": 50,
        "flush_interval_seconds": 5.0,
        "log_dir": "logs",
        "retention_days": 30
    },

    "search": {
        "default_top_k": 5,
        "score_threshold": 0.3,
        "max_token_length": 50,
        "min_token_length": 2
    },

    "audit": {
        "enabled": true,
        "log_format": "jsonl",
        "hash_algorithm": "sha256",
        "retention_days": 365
    },

    "epistemic_guardrails": {
        "banned_phrases": [
            "I'm certain that",
            "This is definitely",
            "There is no doubt",
            "It's guaranteed",
            "You will always win",
            "The court will certainly",
            "This is a slam dunk",
            "No judge would",
            "Any reasonable court",
            "It's black letter law that",
            "There's zero chance",
            "This is an open and shut case",
            "You are guaranteed to prevail",
            "No court has ever"
        ],
        "required_disclaimers": {
            "jurisdiction_specific": "This analysis is based on the cited jurisdiction. Laws and precedent vary by jurisdiction.",
            "not_legal_advice": "This analysis is for informational purposes only and does not constitute legal advice.",
            "fact_dependent": "Legal outcomes depend on specific facts and circumstances. This analysis is based on the facts as presented.",
            "precedent_currency": "Legal precedent may have changed since the last update. Always verify current status via Shepardize or KeyCite."
        }
    },

