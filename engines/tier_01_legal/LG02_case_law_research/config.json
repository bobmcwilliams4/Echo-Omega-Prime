    "citation_treatment_signals": {
        "positive": [
            "followed", "affirmed", "approved", "adopted",
            "harmonized", "relied_upon", "cited_favorably"
        ],
        "negative": [
            "overruled", "reversed", "vacated", "abrogated",
            "superseded", "criticized", "questioned", "limited"
        ],
        "neutral": [
            "cited", "discussed", "mentioned", "compared",
            "distinguished", "explained"
        ],
        "warning": [
            "modified", "partially_overruled", "narrowed",
            "called_into_doubt", "declining_to_follow"
        ]
    },

    "shepardize_signals": {
        "green": {
            "label": "Good Law",
            "description": "Case has positive treatment and is valid precedent",
            "treatments": ["followed", "affirmed", "approved", "adopted"]
        },
        "yellow": {
            "label": "Caution",
            "description": "Case has some negative but not dispositive treatment",
            "treatments": ["questioned", "criticized", "limited", "narrowed"]
        },
        "red": {
            "label": "Negative Treatment",
            "description": "Case has been overruled, reversed, or superseded",
            "treatments": ["overruled", "reversed", "vacated", "abrogated", "superseded"]
        },
        "blue": {
            "label": "Neutral/Cited",
            "description": "Case has been cited without strong positive or negative signal",
            "treatments": ["cited", "discussed", "mentioned", "distinguished"]
        }
    },

    "confidence_bands": {
        "DEFENSIBLE": {
            "min_score": 0.85,
            "label": "Position is well-supported by established precedent",
            "requires_caveat": false
        },
        "SUPPORTABLE": {
            "min_score": 0.65,
            "label": "Position has reasonable support but some uncertainty",
            "requires_caveat": true
        },
        "DISCLOSURE": {
            "min_score": 0.50,
            "label": "Position requires disclosure of contrary authority",
            "requires_caveat": true
        },
        "HIGH_RISK": {
            "min_score": 0.0,
            "label": "Position faces significant adverse authority or is novel",
            "requires_caveat": true
        }
    },

