    "description": "Production-grade intellectual property analysis engine providing patent prosecution, trademark evaluation, copyright analysis, trade secret assessment, IP portfolio management, prior art search, infringement detection, licensing strategy, IP valuation, freedom-to-operate analysis, design patent evaluation, and provisional patent strategy across 35 USC, Lanham Act, 17 USC, DTSA, UTSA, PCT, Madrid Protocol, and Hague Agreement frameworks.",

    "architecture": {
        "layers": [
            {
                "name": "Doctrine Cache",
                "order": 1,
                "latency_target_ms": 200,
                "description": "Pre-compiled IP doctrine for instant retrieval on common patent, trademark, copyright, and trade secret queries"
            },
            {
                "name": "Semantic Search",
                "order": 2,
                "latency_target_ms": 700,
                "description": "TF-IDF inverted index search over IP doctrine blocks and prior art references"
            },
            {
                "name": "IP Analysis",
                "order": 3,
                "latency_target_ms": 1500,
                "description": "Structured IP analysis including claim mapping, infringement detection, and FTO assessment"
            },
            {
                "name": "Deep Analysis",
                "order": 4,
                "latency_target_ms": 3000,
                "description": "Multi-doctrine synthesis for complex IP portfolio and litigation strategy"
            }
        ],
        "normalization": "semantic.py",
        "telemetry": "telemetry.py",
        "search": "search.py",
        "doctrines": "doctrines.py",
        "engine": "engine.py"
    },

    "response_modes": {
        "fast": {
            "description": "Quick doctrine-driven IP guidance with key statutory citations",
            "max_latency_ms": 2000,
            "min_citations": 1
        },
        "analysis": {
            "description": "Structured IP analysis with claim mapping and statutory framework",
            "max_latency_ms": 5000,
            "min_citations": 3
        },
        "memo": {
            "description": "Full IP memorandum with comprehensive citation and risk assessment",
            "max_latency_ms": 10000,
            "min_citations": 5
        },
        "fto": {
            "description": "Freedom-to-operate opinion mode with infringement risk matrix",
            "max_latency_ms": 12000,
            "min_citations": 8
        },
        "portfolio": {
            "description": "Full IP portfolio assessment with valuation and strategy",
            "max_latency_ms": 15000,
            "min_citations": 10
        }
    },

    "ip_categories": {
