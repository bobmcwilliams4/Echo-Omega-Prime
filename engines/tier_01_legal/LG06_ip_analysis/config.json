    "confidence_bands": {
        "DEFENSIBLE": {
            "min_score": 0.85,
            "label": "Position is well-supported by established IP law and precedent",
            "requires_caveat": false
        },
        "SUPPORTABLE": {
            "min_score": 0.65,
            "label": "Position has reasonable support but some uncertainty in application",
            "requires_caveat": true
        },
        "DISCLOSURE": {
            "min_score": 0.50,
            "label": "Position requires disclosure of contrary authority or prosecution history",
            "requires_caveat": true
        },
        "HIGH_RISK": {
            "min_score": 0.0,
            "label": "Position faces significant adverse authority or untested legal theory",
            "requires_caveat": true
        }
    },

    "drift_watcher": {
        "enabled": true,
        "check_interval_hours": 24,
        "staleness_threshold_days": 90,
        "confidence_reduction_percent": 10,
        "registry_path": "doctrine_drift_registry.json",
        "signal_types": [
            "new_patent_case",
            "federal_circuit_opinion",
            "scotus_cert_grant",
            "ptab_precedential",
            "legislative_change",
            "mpep_revision",
            "tmep_update",
            "alice_101_development",
            "international_treaty_change"
        ]
    },

    "telemetry": {
        "enabled": true,
        "ring_buffer_size": 10000,
        "flush_batch_size": 50,
        "flush_interval_seconds": 5.0,
        "log_dir": "logs",
        "retention_days": 30
    },

    "search": {
        "default_top_k": 5,
        "score_threshold": 0.3,
        "max_token_length": 50,
        "min_token_length": 2
    },

    "audit": {
        "enabled": true,
        "log_format": "jsonl",
        "hash_algorithm": "sha256",
        "retention_days": 365
    },

    "epistemic_guardrails": {
        "banned_phrases": [
            "This patent is definitely valid",
            "You will certainly get a patent",
            "There is no prior art",
            "This is clearly not infringing",
            "No reasonable examiner would reject",
            "The trademark is guaranteed to register",
            "You have zero risk of infringement",
            "This is an airtight IP position",
            "No court would find infringement",
            "The patent is bulletproof",
            "There is absolutely no doubt about patentability",
            "Your trade secret is completely safe",
            "Copyright protection is automatic and absolute",
            "This design patent covers everything"
        ],
        "required_disclaimers": {
            "not_legal_advice": "This analysis is for informational purposes only and does not constitute legal advice. Consult a registered patent attorney or trademark attorney for specific legal guidance.",
            "jurisdiction_specific": "IP rights and enforcement vary by jurisdiction. International analysis requires country-specific review.",
            "fact_dependent": "IP outcomes depend heavily on specific facts, claim language, prosecution history, and prior art. This analysis is based on the information provided.",
            "prior_art_caveat": "Prior art searches cannot guarantee completeness. Undiscovered prior art may affect patentability or validity assessments."
        }
    },

    "cors": {
        "allow_origins": ["*"],
        "allow_methods": ["GET", "POST", "OPTIONS"],
        "allow_headers": ["*"]
    },

    "logging": {
        "level": "INFO",
        "format": "{time:YYYY-MM-DD HH:mm:ss.SSS} | {level} | {message}",
        "rotation": "50 MB",
        "retention": "30 days"
    },

