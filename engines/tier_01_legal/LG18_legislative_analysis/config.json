            "key_cases": ["Bostock v. Clayton County (2020)", "King v. Burwell (2015)", "Yates v. United States (2015)", "Nix v. Hedden (1893)"],
            "interpretive_tools": ["legislative_history", "committee_reports", "floor_statements", "signing_statements", "canons_of_construction"]
        },
        "regulatory_rulemaking": {
            "types": ["notice_and_comment", "formal_rulemaking", "direct_final_rule", "interim_final_rule", "negotiated_rulemaking"],
            "key_statutes": ["5 USC 551-559 (APA)", "44 USC 3501 (PRA)", "5 USC 601-612 (RFA)", "2 USC 1501 (UMRA)", "E.O. 12866"],
            "deference_doctrines": ["chevron_deference", "loper_bright", "skidmore_deference", "auer_deference", "kisor_v_wilkie", "major_questions"]
