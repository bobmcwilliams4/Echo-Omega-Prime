    "description": "Production-grade legislative analysis engine providing federal and state legislative process review, statutory construction canon application, bill drafting analysis, regulatory rulemaking assessment, Chevron/Loper Bright deference analysis, congressional oversight, appropriations and budget process, lobbying regulation compliance, preemption analysis, delegation doctrine, enrolled bill doctrine, legislative redistricting, ballot initiative review, Texas Sunset Review, constitutional amendment procedure, and legislative privilege analysis across Article I, APA, and state statutory frameworks.",

    "architecture": {
        "layers": [
            {
                "name": "Doctrine Cache",
                "order": 1,
                "latency_target_ms": 200,
                "description": "Pre-compiled legislative doctrine for instant retrieval on common statutory construction, congressional procedure, and regulatory rulemaking queries"
            },
            {
                "name": "Semantic Search",
                "order": 2,
                "latency_target_ms": 700,
                "description": "TF-IDF inverted index search over legislative doctrine blocks, statutory references, and case citations"
            },
            {
                "name": "Legislative Analysis",
                "order": 3,
                "latency_target_ms": 1500,
                "description": "Structured legislative analysis including bill review, canon application, and regulatory compliance"
            },
            {
                "name": "Deep Analysis",
                "order": 4,
                "latency_target_ms": 3000,
                "description": "Multi-doctrine synthesis for complex preemption questions, delegation challenges, and multi-jurisdictional legislative conflicts"
            }
        ],
        "normalization": "semantic.py",
        "telemetry": "telemetry.py",
        "search": "search.py",
        "doctrines": "doctrines.py",
        "engine": "engine.py"
    },

    "response_modes": {
        "fast": {
            "description": "Quick doctrine-driven legislative guidance with key statutory citations",
            "max_latency_ms": 2000,
            "min_citations": 1
        },
        "analysis": {
            "description": "Structured legislative analysis with canon application and statutory framework",
            "max_latency_ms": 5000,
            "min_citations": 3
        },
        "memo": {
            "description": "Full legislative memorandum with comprehensive citation and impact assessment",
            "max_latency_ms": 10000,
            "min_citations": 5
        },
        "bill_analysis": {
            "description": "Detailed bill analysis with committee pathway, amendment tracking, and impact scoring",
            "max_latency_ms": 12000,
            "min_citations": 8
        },
        "regulatory_review": {
            "description": "Full regulatory rulemaking review with APA compliance, deference analysis, and comment strategy",
            "max_latency_ms": 15000,
            "min_citations": 10
        }
    },

    "legislative_categories": {
