    "description": "Production-grade healthcare law analysis engine providing HIPAA privacy/security/breach notification, HITECH Act, ACA compliance, Medicare/Medicaid fraud (False Claims Act, Anti-Kickback Statute, Stark Law), medical malpractice, informed consent, patient rights, clinical trials/IRB, FDA drug/device regulation, mental health parity (MHPAEA), EMTALA, telemedicine regulation, state medical board licensing, healthcare entity M&A (CON laws), tax-exempt hospital requirements (IRC 501(r)), pharmacy law, substance abuse confidentiality (42 CFR Part 2), public health emergency law, and healthcare data interoperability (21st Century Cures Act) analysis across federal and state statutory frameworks.",

    "architecture": {
        "layers": [
            {
                "name": "Doctrine Cache",
                "order": 1,
                "latency_target_ms": 200,
                "description": "Pre-compiled healthcare law doctrine for instant retrieval on common HIPAA, fraud, malpractice, and regulatory queries"
            },
            {
                "name": "Semantic Search",
                "order": 2,
                "latency_target_ms": 700,
                "description": "TF-IDF inverted index search over healthcare law doctrine blocks and statutory references"
            },
            {
                "name": "Healthcare Analysis",
                "order": 3,
                "latency_target_ms": 1500,
                "description": "Structured healthcare law analysis including HIPAA compliance review, Stark Law evaluation, and fraud risk assessment"
            },
            {
                "name": "Deep Analysis",
                "order": 4,
                "latency_target_ms": 3000,
                "description": "Multi-doctrine synthesis for complex healthcare regulatory issues, multi-jurisdictional compliance, and fraud investigations"
            }
        ],
        "normalization": "semantic.py",
        "telemetry": "telemetry.py",
        "search": "search.py",
        "doctrines": "doctrines.py",
        "engine": "engine.py"
    },

    "response_modes": {
        "fast": {
            "description": "Quick doctrine-driven healthcare law guidance with key statutory citations",
            "max_latency_ms": 2000,
            "min_citations": 1
        },
        "analysis": {
            "description": "Structured healthcare law analysis with statutory framework and compliance assessment",
            "max_latency_ms": 5000,
            "min_citations": 3
        },
        "memo": {
            "description": "Full healthcare law memorandum with comprehensive citation and risk assessment",
            "max_latency_ms": 10000,
            "min_citations": 5
        },
        "compliance_audit": {
            "description": "Compliance audit mode with HIPAA, Stark Law, AKS, and ACA gap analysis",
            "max_latency_ms": 12000,
            "min_citations": 8
        },
        "regulatory_review": {
            "description": "Full regulatory review with multi-statute analysis, enforcement history, and penalty exposure",
            "max_latency_ms": 15000,
            "min_citations": 10
        }
    },

