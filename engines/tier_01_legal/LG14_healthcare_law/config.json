    "confidence_bands": {
        "DEFENSIBLE": {
            "min_score": 0.85,
            "label": "Position is well-supported by established healthcare law and precedent",
            "requires_caveat": false
        },
        "SUPPORTABLE": {
            "min_score": 0.65,
            "label": "Position has reasonable support but some uncertainty in application or jurisdiction",
            "requires_caveat": true
        },
        "DISCLOSURE": {
            "min_score": 0.50,
            "label": "Position requires disclosure of contrary authority, regulatory risk, or jurisdictional variation",
            "requires_caveat": true
        },
        "HIGH_RISK": {
            "min_score": 0.0,
            "label": "Position faces significant adverse authority, untested theory, or active enforcement risk",
            "requires_caveat": true
        }
    },

    "drift_watcher": {
        "enabled": true,
        "check_interval_hours": 24,
        "staleness_threshold_days": 90,
        "confidence_reduction_percent": 10,
        "registry_path": "doctrine_drift_registry.json",
        "signal_types": [
            "new_healthcare_case",
            "scotus_cert_grant",
            "legislative_change",
            "hhs_regulation_change",
            "cms_policy_update",
            "oig_advisory_opinion",
