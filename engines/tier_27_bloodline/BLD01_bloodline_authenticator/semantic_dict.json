    },
    "confidence_stratification": {
      "definition": "A five-level classification of authentication confidence: DEFENSIBLE (>=0.90), AGGRESSIVE (>=0.75), DISCLOSURE (>=0.55), HIGH_RISK (>=0.30), CEREMONY_REQUIRED (<0.30).",
      "related": ["trust level", "assurance", "auth strength"]
    },
    "delegation_token": {
      "definition": "A time-bounded, scope-limited authority grant from a higher-authority identity to a lower-authority identity. Maximum delegate level is 8.0.",
